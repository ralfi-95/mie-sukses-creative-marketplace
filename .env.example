NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://marketplace_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/mie_sukses_marketplace
# For Neon, set DATABASE_URL to the pooled URL and this to DATABASE_URL_UNPOOLED's direct URL.
DATABASE_URL_UNPOOLED=
SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://127.0.0.1:5173
UPLOAD_DIR=./storage

# Render production only; keep these values out of Netlify and frontend builds.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=YOUR_PRIVATE_BUCKET_NAME
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_REGION=auto
